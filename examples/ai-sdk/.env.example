# TrustGuard: the Application → Node.js collector's key, and the public base URL
# from its Connection tab. Not the operator's internal TRUSTGUARD_URL.
TRUSTGUARD_BASE_URL=https://trustguard.neuraltrust.ai
TRUSTGUARD_API_KEY=tgk_...

# The model provider. The example uses OpenAI; any AI SDK provider works.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2

# Signs tool approval requests so the browser cannot forge an approval.
# Generate one with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# "monitor" streams the answer and records findings when it ends.
# "buffer" holds each text block until TrustGuard has evaluated it.
TRUSTGUARD_STREAM=monitor
